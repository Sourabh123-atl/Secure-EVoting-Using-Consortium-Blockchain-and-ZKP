# Baseline application. Use only synthetic account data in local development.
NODE_ENV=development
PORT=4173
APP_BASE_URL=http://localhost:4173
API_BASE_URL=http://localhost:4173
CIVICCHAIN_DATA_DIR=data
LOG_LEVEL=info

# Reserved for the planned PostgreSQL / shared-session adapter; not consumed by the current JSON-backed runtime.
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional live EVM integration. Leave empty until a real local test chain and contracts exist.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=31337
CHAIN_ID=31337
ELECTION_REGISTRY_ADDRESS=
VOTING_CONTRACT_ADDRESS=
ELIGIBILITY_ROOT_REGISTRY_ADDRESS=
TALLY_REGISTRY_ADDRESS=
BLOCKCHAIN_ADMIN_PRIVATE_KEY=
BLOCKCHAIN_SUBMITTER_PRIVATE_KEY=
VALIDATOR_RPC_URLS=

# Optional proof artifacts generated from the exact checked-in circuit version.
ZK_VERIFICATION_KEY_PATH=circuits/build/verification_key.json
ZK_WASM_PATH=circuits/build/eligibility_js/eligibility.wasm
ZK_ZKEY_PATH=circuits/build/eligibility_final.zkey
PROOF_VERIFICATION_KEY_PATH=circuits/build/verification_key.json
PROOF_ARTIFACT_VERSION=eligibility-v1-local
ZK_PUBLIC_WITNESS_MODE=browser

# Development-only ballot encryption helper. This is not homomorphic encryption or threshold decryption.
BALLOT_ENCRYPTION_PUBLIC_KEY_PATH=data/ballot-public.pem
BALLOT_ENCRYPTION_PUBLIC_KEY=

# Reserved for future issuer and threshold-tally integrations; not consumed by the baseline runtime.
CREDENTIAL_ISSUER_PUBLIC_KEY=
TRUSTEE_THRESHOLD=2
