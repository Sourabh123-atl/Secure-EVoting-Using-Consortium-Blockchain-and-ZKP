{
  "name": "civicchain-secure-evoting",
  "version": "0.1.0",
  "private": true,
  "description": "Academic secure e-voting prototype using consortium blockchain and zero-knowledge proofs",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "keys:generate": "node scripts/generate-ballot-keys.js",
    "zk:compile": "mkdir -p circuits/build && circom2 circuits/eligibility.circom --r1cs --wasm --sym -l node_modules -o circuits/build",
    "zk:setup": "bash scripts/setup-zk.sh",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:local": "hardhat run scripts/deploy-contracts.js --network localhost"
  },
  "dependencies": {
    "ethers": "6.14.0",
    "snarkjs": "0.7.5",
    "@openzeppelin/contracts": "5.2.0",
    "circomlibjs": "0.1.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "hardhat": "2.22.18"
  }
}
